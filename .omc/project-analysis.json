  "trading_logic_summary": {
    "buy_strategy": {
      "step_1": "Check filter condition - all filter_stocks must be rising (if ENABLE_FILTER_CHECK=True)",
      "step_1_alt": "If sectors defined: sector-OR logic (any sector passing = OK, within sector: any stock rising = sector pass)",
      "step_2": "Select top 3 declining stocks from watch_list",
      "step_3": "Check previous sell price (skip if current price > last sell price)",
      "step_4": "Check stop-loss blacklist (skip if in cooldown period)",
      "step_5": "Calculate position size: available_cash / 3, max 100 shares",
      "step_6": "Place buy order"
    },
    "sell_strategy": {
      "step_1": "Get account balance and positions",
      "step_2": "For each position, calculate profit rate using API-sourced average price",
      "step_3": "If profit_rate >= PROFIT_THRESHOLD (5%): sell (highest profit first)",
      "step_4": "If profit_rate <= STOP_LOSS_THRESHOLD: execute stop-loss sell and add to blacklist"
    },
    "stop_loss": {
      "us_market": {"threshold": "-15%", "cooldown_days": 100},
      "kr_market": {"threshold": "-10%", "cooldown_days": 50}
    }
  },

  "token_architecture": {
    "description": "US and KR tokens are independently managed with prefix-based file separation",
    "us_files": ["us_api_token.json", "us_token_issued_at.dat", "us_krs_token.dat"],
    "kr_files": ["kr_api_token.json", "kr_token_issued_at.dat", "kr_krs_token.dat"],
    "legacy_files": ["api_token.json", "token_issued_at.dat", "token.dat"],
    "policy": {
      "expiry": "24 hours (KIS API policy)",
      "auto_renewal": "Triggers when < 5 hours remaining",
      "emergency_reissue": "Bypasses 24h limit when token file missing"
    }
  },

  "configuration_hierarchy": {
    "credentials": {
      "priority_1": ".env file (via python-dotenv)",
      "priority_2": "config.py fallback values",
      "key_vars": ["KIS_APP_KEY", "KIS_APP_SECRET", "KIS_ACCOUNT_NUMBER"]
    },
    "trading_params": {
      "source": "config.py",
      "key_params": {
