  "directory_structure": {
    "common/": {
      "description": "Abstract base classes (ABC) for shared trading system functionality",
      "files": {
        "__init__.py": {
          "exports": ["BaseTokenManager", "BaseAPIClient", "BaseStrategy"],
          "description": "Package init - exports all three base classes"
        },
        "base_api.py": {
          "class": "BaseAPIClient(ABC)",
          "lines": 222,
          "abstract_methods": ["get_timezone()", "get_market_hours()", "get_account_balance()", "get_current_price(symbol)", "place_order(symbol, side, quantity, price)"],
          "concrete_methods": ["is_market_open()", "get_market_status()", "get_cached_price()", "set_cached_price()", "clear_cache()", "get_price_with_cache()", "calculate_position_size()", "format_order_result()"],
          "description": "Base API client with market time checking, price caching, and position sizing"
        },
        "base_strategy.py": {
          "class": "BaseStrategy(ABC)",
          "lines": 367,
          "abstract_methods": ["execute_buy_strategy()", "execute_sell_strategy()", "should_buy(symbol)", "should_sell(symbol, profit_rate)", "get_watch_list()", "get_filter_stocks()"],
          "concrete_methods": ["check_filter_condition()", "_check_sector_filter_condition()", "get_passing_sectors()", "_get_previous_close()", "record_sell_price()", "get_last_sell_price()", "clear_sell_price()", "is_price_above_last_sell()", "get_top_declining_stocks()", "get_strategy_stats()", "reset_stats()"],
          "description": "Base trading strategy with filter logic (AND/sector-OR), sell price tracking, declining stock ranking, and execution statistics"
        },
        "base_token_manager.py": {
          "class": "BaseTokenManager(ABC)",
          "lines": 344,
          "abstract_methods": ["get_api_url()", "get_app_credentials()", "get_token_file_prefix()"],
          "concrete_methods": ["get_last_issued_time()", "set_last_issued_time()", "can_issue_token()", "issue_new_token()", "save_token()", "load_token()", "get_valid_token()", "delete_token()", "get_token_info()", "is_token_valid()"],
          "constants": {
            "TOKEN_EXPIRY_HOURS": 24,
            "REFRESH_THRESHOLD_HOURS": 5
          },
          "description": "Base token lifecycle manager with 24h expiry policy, auto-renewal, and prefix-based file separation"
        }
      }
    },

