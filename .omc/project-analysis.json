    }
  },

  "conventions": {
    "timezone": "All time comparisons use pytz timezone-aware datetimes. US=US/Eastern, KR=Asia/Seoul",
    "settlement": "T+1 for US stocks (changed from T+2 on May 28, 2024). Only ord_psbl_qty (settled shares) for sell orders",
