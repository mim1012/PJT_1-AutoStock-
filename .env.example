# ========================================
# 한국투자증권 24시간 자동매매 시스템
# API 인증 정보 설정 파일
# ========================================
#
# 사용 방법:
# 1. 이 파일을 .env로 복사: cp .env.example .env
# 2. 아래 값들을 실제 정보로 변경
# 3. .env 파일은 절대 Git에 커밋하지 마세요!
#
# ========================================

# API 키 발급 방법:
# 1. https://securities.koreainvestment.com/main/index.jsp 접속
# 2. KIS Developers → Open API 신청
# 3. APP KEY, APP SECRET 발급
# 4. 아래에 붙여넣기

KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here

# 계좌번호 (형식: 12345678-01)
KIS_ACCOUNT_NUMBER=your_account_number_here

# 거래 모드 (True=모의투자, False=실전투자)
# ⚠️ 실전투자는 실제 돈으로 거래됩니다!
USE_PAPER_TRADING=True

# ========================================
# 키움증권 조건검색 실시간 발굴 (선택 — 단테 Stage 0-B)
# ========================================
# 신 REST/WebSocket OpenAPI (openapi.kiwoom.com). Mac/Linux 가능, HTS 상시실행 불필요.
# 조건식은 영웅문4 [0150]에서 작성·저장(자동 서버저장) 후 seq로 호출.
# 미설정 시 PoC는 자동 드라이런으로 동작.
KIWOOM_APP_KEY=your_kiwoom_app_key_here
KIWOOM_SECRET_KEY=your_kiwoom_secret_key_here
KIWOOM_PAPER=False
